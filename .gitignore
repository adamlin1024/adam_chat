# Frontend dependencies & build
vocechat-web/node_modules/
vocechat-web/build/

# wwwroot is rebuilt by Docker, no need to track
vocechat-data/wwwroot/

# User data (sensitive, managed by Railway volume)
vocechat-data/db/
vocechat-data/msg/
vocechat-data/upload/
vocechat-data/avatar/
vocechat-data/group_avatar/
vocechat-data/favorite/
vocechat-data/key.json
vocechat-data/license

# OS
.DS_Store
Thumbs.db

# Local utility scripts
parse_transcripts.js

# Google OAuth client secret (never commit!)
client_secret_*.json

# 開發過程的臨時檔（底線開頭一律當作臨時物排除）
_*

# 大型素材（暫不上 git）
sticker/

# vocechat-data 內額外排除（除既有規則外）
vocechat-data/archive_msgs/

# LINE 匯入工具：保留腳本，排除資料 / 憑證 / 快取
import-line/.env
import-line/.env.template
import-line/.import_cache.json
import-line/__pycache__/
import-line/backup_*.json

